{
  "name": "nightseek-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.13.1",
  "type": "module",
  "description": "NightSeek - Astronomy Observation Planning PWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "check": "biome check src --max-diagnostics 300",
    "check:fix": "biome check --write src",
    "type-check": "tsc --noEmit",
    "dead-code": "knip --include files,exports",
    "validate": "npm run type-check && npm run check && npm run test:run",
    "validate:full": "npm run validate && npm run dead-code"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched",
      "vitest related --run"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "aladin-lite": "3.9.0-beta",
    "astronomy-engine": "^2.1.19",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satellite.js": "^7.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "lint-staged": "^17.5.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=24"
  }
}
